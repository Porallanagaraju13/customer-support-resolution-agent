# Copy to .env. Leave OPENAI_API_KEY empty to run in deterministic offline MOCK mode.
LLM_MODE=auto               # auto (key set -> openai, else mock) | mock | openai
OPENAI_API_KEY=
API_KEY_ENV=                # optional: name of another env var holding the key, e.g. GEMINI_API_KEY
LLM_TEMPERATURE=0
MODEL=gpt-4o-mini
BASE_URL=                   # any OpenAI-compatible endpoint, e.g. https://api.openai.com/v1 or http://localhost:11434/v1
EMBEDDINGS=local            # local (TF-IDF, no key) | openai
EMBEDDING_MODEL=text-embedding-3-small

REFUND_APPROVAL_THRESHOLD=50
TOOL_TIMEOUT_S=5
TOOL_MAX_RETRIES=3
TOOL_BACKOFF_BASE_S=0.2
MOCK_DELAY_S=0              # e.g. 0.6 to make the live timeline visible in the UI
DATA_DIR=./data
